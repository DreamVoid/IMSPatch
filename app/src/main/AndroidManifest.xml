<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.intent.action.SIM_STATE_CHANGED"/>
    
    <instrumentation
            android:name="io.github.vvb2060.ims.PrivilegedProcess"
            android:targetPackage="${applicationId}"/>

    <application
            android:label="@string/app_name"
            android:icon="@drawable/ic_sim_card"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:theme="@android:style/Theme.NoDisplay">
        </activity>

        <activity-alias
                android:name=".SettingsActivity"
                android:exported="true"
                android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
                android:name=".LauncherActivity"
                android:exported="true"
                android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
                android:name=".EventListener"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.SIM_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <provider
                android:name="io.github.vvb2060.ims.ShizukuProvider"
                android:authorities="${applicationId}.shizuku"
                android:exported="true"
                android:multiprocess="false"
                android:permission="android.permission.NETWORK_SETTINGS"/>
    </application>

</manifest>